{
  "name": "ai-test-page-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "React 前端 monorepo：pages 放页面应用，components 放可独立构建发布的组件包",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm build:components && pnpm -r --parallel dev",
    "dev:page": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "build:select": "node scripts/build.mjs",
    "build:components": "pnpm --filter \"./components/*\" build",
    "build:pages": "pnpm --filter \"./pages/*\" build",
    "preview": "pnpm --filter @ai-test/playground preview",
    "clean": "pnpm -r exec rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && stylelint \"**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.scss\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build:components && changeset publish"
  },
  "dependencies": {
    "@ant-design/icons": "catalog:",
    "@ant-design/v5-patch-for-react-19": "catalog:",
    "antd": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@changesets/get-github-info": "^0.6.0",
    "@eslint/js": "^9.39.0",
    "@stylistic/stylelint-config": "^3.0.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "catalog:",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "sass": "catalog:",
    "stylelint": "^16.24.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.0",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
