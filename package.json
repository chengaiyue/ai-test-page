{
  "name": "ai-test-page-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "React 前端 monorepo：pages 放页面应用，components 放可独立构建发布的组件包",
  "scripts": {
    "dev": "pnpm build:components && pnpm -r --parallel dev",
    "dev:page": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "build:select": "node scripts/build.mjs",
    "build:components": "pnpm --filter \"./components/*\" build",
    "build:pages": "pnpm --filter \"./pages/*\" build",
    "preview": "pnpm --filter @ai-test/playground preview",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.22.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3",
    "rollup": "^4.28.0",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.83.0",
    "tslib": "^2.8.0",
    "typescript": "^5",
    "vite": "^6"
  },
  "engines": {
    "node": ">=18"
  }
}
