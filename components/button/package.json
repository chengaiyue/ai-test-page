{
  "name": "@ai-test/button",
  "version": "0.1.0",
  "description": "React Button 公共组件（monorepo 独立发包示例）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "rollup -c ../../build/rollup.component.mjs",
    "dev": "rollup -c ../../build/rollup.component.mjs -w",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "react",
    "component",
    "button"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
